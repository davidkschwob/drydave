# 1. Output file format (can be .gif, .webm, or .mp4)
Output demo.gif

# 2. Terminal Settings
Set FontSize 32
Set Width 1200
Set Height 600
Set TypingSpeed 100ms

# pull an llm
Type "ollama pull llama3.2:1b"
Enter
Sleep 3s

# pass "Hi" and get response
Type 'ollama run llama3.2:1b "Hi"'
Sleep 500ms
Enter

Sleep 15s

